# Yerel PostgreSQL (V2 vector_index / oturum tabloları)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chatbot_db

# setup_local_db.py — opsiyonel (varsayılanlar aşağıdaki gibidir)
POSTGRES_DB=chatbot_db
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Admin API — POST /api/admin/add_qa Bearer token
ADMIN_API_TOKEN=your-secret-token-here

# Allintos qa_embeddings senkronu (index_sync._sync_allintos)
ALLINTOS_DB_ENABLED=false
ALLINTOS_DB_URL=postgresql+psycopg2://user:password@host:5433/allintos
