# PostgreSQL Bağlantı Ayarları
# Eğer postgres kullanıcısının şifresi 'postgres' değilse, lütfen aşağıdaki 'postgres' kısmını (şifreyi) güncelleyin.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chatbot_db
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
POSTGRES_DB=chatbot_db

# Allintos Veritabanı Entegrasyonu (Feature Flag)
ALLINTOS_DB_ENABLED=false
ALLINTOS_DB_URL=postgresql+psycopg2://postgres:demo1234@10.20.40.154:5433/chatbot_db
