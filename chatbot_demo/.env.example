# Yerel PostgreSQL (V2 vector_index / oturum tabloları)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chatbot_db

# setup_local_db.py — opsiyonel (varsayılanlar aşağıdaki gibidir)
POSTGRES_DB=chatbot_db
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Admin API — POST /api/admin/add_qa Bearer token
ADMIN_API_TOKEN=your-secret-token-here

# Allintos qa_embeddings senkronu (index_sync._sync_allintos) — yazma
ALLINTOS_DB_ENABLED=true
ALLINTOS_DB_URL=postgresql+psycopg2://user:password@host:5433/allintos

# Sinem DB salt-okunur (gölge mod / shadow read — K2 karşılaştırma)
ALLINTOS_READONLY_DB_URL=postgresql+psycopg2://chatbot_ro:password@host:5433/allintos
SHADOW_READ_ENABLED=true
SHADOW_READ_TOP_K=50

# Vektor arama kaynagi: local | primary | shadow
# primary = canli cevaplar Sinem qa_embeddings uzerinden
ALLINTOS_RETRIEVAL_MODE=local

# K0 kurumsal kaynak: allintos (knowledge_documents) | local (JSON)
ALLINTOS_K0_SOURCE=allintos

# Oturum/mesaj kaliciligi: allintos | local
ALLINTOS_CHAT_DB=allintos

# Allintos okuma basarisiz olursa yerel vector_index/NPZ (true önerilir)
ALLINTOS_LOCAL_FALLBACK=true

# Allintos site kök URL — sektör form yönlendirmeleri (dijital-olgunluk)
ALLINTOS_SITE_URL=http://10.20.40.154:5000
